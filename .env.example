# Copy to .env and fill in values. Never commit .env.

# Required for all services (use same value across services)
# Base64-encoded signing key (256+ bits). Dev default matches application-local.yml.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Local IDE runs: activate dev defaults in application-local.yml
SPRING_PROFILES_ACTIVE=local

# Database (docker-compose defaults)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/staysphere
SPRING_DATASOURCE_USERNAME=staysphere
SPRING_DATASOURCE_PASSWORD=staysphere123

# Optional integrations
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=StaySphere

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
