# Copy to .env and fill in your values:  cp env.template .env

SPRING_PROFILES_ACTIVE=local

POSTGRES_USER=staysphere
POSTGRES_PASSWORD=staysphere123
POSTGRES_DB=staysphere
# Published Docker port on your PC (default 5433). Local PostgreSQL can keep 5432.
POSTGRES_HOST_PORT=5433
SPRING_DATASOURCE_USERNAME=staysphere
SPRING_DATASOURCE_PASSWORD=staysphere123
# IDE / bootRun on host → Docker Postgres. Containers use postgres:5432 via docker-compose.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/staysphere

# At least 32 characters, OR a Base64-encoded 256-bit key (must match across all services)
JWT_SECRET=dev-only-change-me-minimum-32-characters-long
JWT_EXPIRATION=86400000

# OAuth (auth-service + frontend VITE_* for Google/GitHub buttons)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# First admin: register this email, then restart auth-service (or set before first login)
STAYSPHERE_BOOTSTRAP_ADMIN_EMAIL=

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# API gateway token-bucket rate limits (Redis)
GATEWAY_RATE_LIMIT_REPLENISH=80
GATEWAY_RATE_LIMIT_BURST=160
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Email (Amazon SES SMTP, ap-south-1): SES → SMTP settings → IAM SMTP credentials
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Verified SES domain or sender (e.g. noreply@yourdomain.com)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=StaySphere

# Password reset links (auth-service)
FRONTEND_BASE_URL=http://localhost:5173

# Property media (S3 presigned upload — property-service)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# IAM user or role with s3:PutObject, s3:GetObject, s3:DeleteObject, s3:HeadObject on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront URL (no trailing slash). If empty, public URLs use the bucket virtual host.
STAYSPHERE_S3_PUBLIC_BASE_URL=
STAYSPHERE_S3_PRESIGN_EXPIRY_MINUTES=15
STAYSPHERE_S3_MAX_IMAGE_BYTES=10485760
STAYSPHERE_S3_MAX_VIDEO_BYTES=524288000

PROPERTY_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083

# Browser SPA origins allowed by api-gateway CORS (comma-separated)
# Add https://your-production-domain.com when SPA is not same-origin as API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Frontend Docker build (optional; OAuth buttons). Also set in frontend/.env for Vite dev.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_OLA_MAPS_API_KEY=
